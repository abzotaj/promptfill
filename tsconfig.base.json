{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@promptfill/core": [
        "packages/core/src/index.ts"
      ],
      "@promptfill/widget": [
        "packages/widget/src/index.ts"
      ],
      "@promptfill/faker": [
        "packages/faker/src/index.ts"
      ],
      "@promptfill/faker/locales": [
        "packages/faker/src/locales.ts"
      ]
    }
  }
}
