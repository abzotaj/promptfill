# Leave empty to run in mock mode (fake data, no API calls).
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5-5. A Haiku model is cheaper and fast enough for most forms.
PROMPTFILL_MODEL=

# Which publishable keys may be used from which origins.
# Format: key=origin1,origin2;key2=origin3   (trailing * wildcard allowed)
PROMPTFILL_SITES=pk_demo=http://localhost:5173,http://127.0.0.1:5173;pk_ext=chrome-extension://*

PORT=8787
PROMPTFILL_RATE_LIMIT=20
